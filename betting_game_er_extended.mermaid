erDiagram
    %% Core Domain Tables (Projections)
    User |o--|| Participant : "is assigned to"
    Participant ||--o{ GameParticipation : "joins via"
    BettingGame ||--o{ GameParticipation : "has members via"
    BettingGame ||--o{ Event : "contains"
    Participant ||--o{ Prediction : "makes"
    Event ||--o{ Prediction : "receives"
    Event ||--o| Result : "has"
    BettingGame ||--|| GameType : "has type"
    BettingGame ||--o| PointConfiguration : "uses (sports)"
    BettingGame ||--o| PrizeDistribution : "uses (lottery)"
    Participant ||--o{ ParticipantScore : "earns"
    BettingGame ||--o{ ParticipantScore : "awards"
    Event ||--o{ ParticipantScore : "scored for"
    Participant ||--o{ Fee : "pays"
    BettingGame ||--o{ Fee : "requires"

    %% Event Sourcing Tables
    EventStore ||--o{ EventStream : "contains"
    EventStream ||--o{ Snapshot : "has"
    Participant ||--o{ EventStream : "owns stream"
    BettingGame ||--o{ EventStream : "owns stream"
    Prediction ||--o{ EventStream : "owns stream"
    EventStore ||--o{ EventPublisher : "publishes to"
    EventPublisher ||--o{ ProjectionState : "updates"

    User {
        int user_id PK
        string username UK
        string password_hash
        string email UK
        datetime created_at
        datetime last_login
        boolean is_active
    }

    Participant {
        int participant_id PK
        int user_id FK "nullable, UK - optional account link"
        string display_name
        datetime registered_at
        boolean is_active
        int version "Optimistic locking"
    }

    GameParticipation {
        int participation_id PK
        int participant_id FK "UK(participant_id, betting_game_id)"
        int betting_game_id FK
        datetime joined_at
        datetime left_at "nullable"
        string status
        int version "Optimistic locking"
    }

    BettingGame {
        int betting_game_id PK
        string name
        string description
        int game_type_id FK
        datetime start_date
        datetime end_date
        string status
        decimal base_fee
        int fee_period_days
        datetime created_at
        int version "Optimistic locking"
    }

    GameType {
        int game_type_id PK
        string type_name
        string category
        string description
    }

    Event {
        int event_id PK
        int betting_game_id FK
        string event_name
        string external_event_id
        datetime event_date
        string status
        datetime deadline
        json event_details "JSONB - queryable/validated"
        int version "Optimistic locking"
    }

    Prediction {
        int prediction_id PK
        int participant_id FK "UK(participant_id, event_id)"
        int event_id FK
        json prediction_data "JSONB - queryable/validated"
        datetime submitted_at
        datetime updated_at
        int version "Optimistic locking"
    }

    Result {
        int result_id PK
        int event_id FK "UK - max. one result per event"
        json result_data "JSONB - queryable/validated"
        datetime recorded_at
        datetime updated_at
        string source
        int version "Optimistic locking"
    }

    PointConfiguration {
        int config_id PK
        int betting_game_id FK "UK - max. one config per game"
        string scoring_rule_name
        int points_exact_match
        int points_close_match
        int points_partial_match
        int points_wrong
        json configuration_json "JSONB"
    }

    PrizeDistribution {
        int distribution_id PK
        int betting_game_id FK "UK - max. one distribution per game"
        decimal total_prize_pool
        string distribution_schema
        json rank_percentages "JSONB"
        int min_winners
        int max_winners
    }

    ParticipantScore {
        int score_id PK
        int participant_id FK "UK(participant_id, event_id)"
        int betting_game_id FK
        int event_id FK
        int points_earned
        decimal prize_amount
        datetime calculated_at
        datetime updated_at
        int version "Optimistic locking"
    }

    Fee {
        int fee_id PK
        int participant_id FK "UK(participant_id, betting_game_id, period_start)"
        int betting_game_id FK
        decimal amount
        datetime period_start
        datetime period_end
        datetime paid_at
        string payment_status
        string payment_method
        int version "Optimistic locking"
    }

    %% Event Sourcing Tables
    EventStore {
        bigint event_store_id PK
        string aggregate_type "UK(aggregate_type, aggregate_id, version)"
        string aggregate_id
        bigint version
        string event_type
        json event_data "JSONB"
        json metadata "JSONB"
        datetime occurred_at
        string causation_id "Command ID"
        string correlation_id "Trace ID"
    }

    EventStream {
        string stream_id PK
        string aggregate_type "UK(aggregate_type, aggregate_id)"
        string aggregate_id
        bigint current_version
        datetime created_at
        datetime updated_at
    }

    Snapshot {
        bigint snapshot_id PK
        string stream_id FK "UK(stream_id, version)"
        bigint version
        json aggregate_state "JSONB"
        datetime created_at
    }

    ProjectionState {
        string projection_name PK
        bigint publisher_id FK
        bigint last_processed_position
        string status
        datetime updated_at
        text error_message
    }

    EventPublisher {
        bigint publisher_id PK
        string event_type
        bigint last_published_position
        datetime last_published_at
    }
