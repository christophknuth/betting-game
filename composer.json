{
    "name": "betting-game/api",
    "description": "High-performance betting game API with Event Sourcing and CQRS",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "ext-json": "*",
        "nikic/fast-route": "^1.3",
        "php-di/php-di": "^7.0",
        "ramsey/uuid": "^4.7",
        "psr/log": "^3.0",
        "psr/container": "^2.0",
        "psr/simple-cache": "^3.0",
        "monolog/monolog": "^3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "BettingGame\\Domain\\": "src/Domain/",
            "BettingGame\\Application\\": "src/Application/",
            "BettingGame\\Infrastructure\\": "src/Infrastructure/",
            "BettingGame\\Presentation\\": "src/Presentation/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BettingGame\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox",
        "test-coverage": "phpunit --coverage-html coverage --coverage-text",
        "phpstan": "phpstan analyse",
        "cs-check": "phpcs --standard=PSR12 src tests public config",
        "cs-fix": "phpcbf --standard=PSR12 src tests public config"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
