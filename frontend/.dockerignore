# Created by `npm install` in the build stage itself. Smuggling in the copy
# from the host would be not just slow but wrong: it holds symlinks and
# platform-dependent binaries (esbuild) that do not fit the Linux image.
node_modules

# The build's output, not its input
dist

# .env deliberately stays in: Vite bakes the VITE_ variables in at build time.
# Without the file the build would fall back to the defaults in services/keycloak.js.

*.log
