# Git
.git
.gitignore
.gitattributes

# Documentation
*.md
!README.md

# IDE
.idea
.vscode
*.swp
*.swo
*~

# Tests
tests/
phpunit.xml
.phpunit.cache
coverage/

# CI/CD
.github
.gitlab-ci.yml
.travis.yml

# Docker
#
# docker/ stays in: the production image copies its Caddyfile, php.ini and
# entrypoint from there. The compose files and the Dockerfile itself are not
# needed inside an image.
docker-compose.yml
docker-compose.*.yml
Dockerfile

# Logs
*.log
logs/

# Cache
var/cache/
var/log/
.phpunit.result.cache

# Node
#
# node_modules is the one that has to stay out, and not only for size: on
# Windows npm writes the entries in node_modules/.bin as symlinks, and the
# client finds no file mode for those to put in the context tar, so the build
# dies with "unknown file mode ?rw-rw-rw-". A pattern without ** would only
# match at the top level.
**/node_modules

# Built by the image itself in its own stage; a copy from the host would just
# shadow it with whatever was last built locally.
frontend/dist

# Composer
#
# vendor/ is installed inside the image; composer.lock must NOT be excluded -
# it is what makes the install reproducible, and without it the build resolves
# a fresh dependency tree that nothing has tested.
vendor/

# Environment
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Archives
*.tar.gz
*.zip
*.rar

# Build artifacts
dist/
build/
