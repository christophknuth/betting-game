# Frontend
# The PHP image copies the whole context (COPY . /var/www/html) and needs none
# of this: the SPA has its own image with its own context (./frontend).
#
# Without this entry the build breaks on Windows as soon as someone runs
# `npm install` inside frontend/: npm creates the entries in node_modules/.bin
# as symlinks, and the Windows client finds no file mode for those to write
# into the context tar ("unknown file mode ?rw-rw-rw-").
frontend/

# Node - in case node_modules ever turns up elsewhere in the tree.
# A pattern without ** only matches at the top level.
**/node_modules

# Composer
vendor/
composer.lock

