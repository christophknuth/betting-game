# Template for docker-compose.prod.yml. Copy to .env and fill in every value.
#
# Compose is configured to refuse to start when one of these is missing, rather
# than quietly running production on a development default. There is no
# fallback here that would be safe to ship.

# --- The public address of Keycloak -----------------------------------------
#
# The URL a *browser* uses. Two things read it: the SPA, so it knows where to
# send people to log in, and KEYCLOAK_ISSUER, which the API compares verbatim
# against a token's iss claim.
#
# It is not the internal hostname. Keycloak writes into the token the URL the
# browser fetched it from, so an internal name here rejects every genuine token
# with a 401 that says nothing about why.
PUBLIC_KEYCLOAK_URL=https://id.example.com

KEYCLOAK_REALM=betting-game
KEYCLOAK_FRONTEND_CLIENT_ID=betting-game-frontend

# The bootstrap administrator, created once on Keycloak's first start.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# --- Databases ---------------------------------------------------------------
DB_DATABASE=betting_game
DB_USERNAME=betting_game
DB_PASSWORD=
DB_ROOT_PASSWORD=

KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=
