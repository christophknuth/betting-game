# Application
APP_ENV=development
APP_DEBUG=true

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=betting_game
DB_USERNAME=root
DB_PASSWORD=

# Cache (PSR-16)
CACHE_DRIVER=file          # file, redis
CACHE_TTL=3600             # Default TTL in seconds
CACHE_PATH=var/cache

# Redis (if CACHE_DRIVER=redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# There is deliberately no JWT secret. Tokens are signed by Keycloak with RS256
# and verified against its published public key. A shared secret here would only
# invite an HS256 path, and an application accepting both can be handed a token
# forged with the very key it publishes.

# OIDC Configuration
OIDC_ISSUER=https://auth.bettinggame.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8090
KEYCLOAK_REALM=betting-game
KEYCLOAK_CLIENT_ID=betting-game-api
KEYCLOAK_FRONTEND_CLIENT_ID=betting-game-frontend

# Token verification
# The iss claim, which must match exactly. Keycloak issues its *frontend* URL,
# so behind a reverse proxy this is the public address and not KEYCLOAK_URL.
# Defaults to KEYCLOAK_URL/realms/KEYCLOAK_REALM.
#KEYCLOAK_ISSUER=https://auth.example.com/realms/betting-game
# Where the realm publishes its public signing keys. Defaults to
# KEYCLOAK_URL/realms/KEYCLOAK_REALM/protocol/openid-connect/certs.
#KEYCLOAK_JWKS_URL=
# How long a fetched key set is used before looking again, in seconds.
KEYCLOAK_JWKS_TTL=300
# A key set supplied directly, as JSON or as a path to a file holding it, for a
# deployment that cannot reach Keycloak at request time. When set, nothing is
# fetched.
#KEYCLOAK_JWKS=/etc/betting-game/jwks.json
# Checked against aud when set. Off by default: Keycloak's audience depends on
# how the client's mappers are configured, and a check that is on by default
# with the wrong value locks everyone out.
#KEYCLOAK_AUDIENCE=betting-game-api
# Tolerance for clock drift between us and Keycloak, in seconds.
KEYCLOAK_LEEWAY=30

# Logging
LOG_LEVEL=debug
LOG_PATH=/var/log/betting-game

# Performance
OPCACHE_ENABLE=1
REALPATH_CACHE_SIZE=4096K
REALPATH_CACHE_TTL=600
