# Application
APP_ENV=development
APP_DEBUG=true

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=betting_game
DB_USERNAME=root
DB_PASSWORD=

# Cache (PSR-16)
CACHE_DRIVER=file          # file, redis
CACHE_TTL=3600             # Default TTL in seconds
CACHE_PATH=var/cache

# Redis (if CACHE_DRIVER=redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# JWT Authentication
JWT_SECRET=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# OIDC Configuration
OIDC_ISSUER=https://auth.bettinggame.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8090
KEYCLOAK_REALM=betting-game
KEYCLOAK_CLIENT_ID=betting-game-api
KEYCLOAK_FRONTEND_CLIENT_ID=betting-game-frontend

# Logging
LOG_LEVEL=debug
LOG_PATH=/var/log/betting-game

# Performance
OPCACHE_ENABLE=1
REALPATH_CACHE_SIZE=4096K
REALPATH_CACHE_TTL=600
